(local H 136)
(local W 240)
(local C 2)

(fn trib [{: x : y : w : h : border : bgc : col}]
  (let [border (or border 2)
        bgc (or bgc 0)]
    (tri x y
         (+ x w) y
         (+ x (/ w 2)) (+ y h)
         col)

    (tri (+ x (* border 2.5)) (+ y border)
         (- (+ x w) (* border 2.5)) (+ y border)
         (+ x (/ w 2)) (- (+ y h) (* border 2))
         bgc)
  ))

(fn _G.TIC []
  (cls 0)
  (rectb 0 0 240 136 C)
  (trib {:col C :x 50 :y 20 :w 180 :h 110})
  )

